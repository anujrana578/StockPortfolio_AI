# FinSight Application Environment Configuration
# Copy this file to .env and replace with your actual values

# Flask Server Configuration
PORT=5000
FLASK_ENV=development
SECRET_KEY=finsight_super_secret_jwt_key_2026_change_in_production
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 / OpenID Connect Credentials
# Obtain these from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Database Configuration
DATABASE_URL=sqlite:///finsight.db
